{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/relay?route=:route*"
    }
  ],
  "functions": {
    "api/relay.js": {
      "maxDuration": 45
    }
  },
  "buildCommand": "node scripts/production-migrate.js && npm run build",
  "outputDirectory": "dist"
}
